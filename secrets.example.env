# Copy to secrets.env for local testing only -- NEVER commit the real file.
#
# In the cloud routine, these must be provided as environment variables on the
# routine's environment. Check the claude.ai environment settings UI for a
# secrets/env-var mechanism before falling back to any repo-committed option --
# see README.md "Secrets" section for the fallback plan if no such mechanism exists.

YOUTUBE_API_KEY=              # YouTube Data API v3 key, used for trend search only
YOUTUBE_CLIENT_ID=            # OAuth client ID (Desktop app), used for upload + analytics
YOUTUBE_CLIENT_SECRET=        # OAuth client secret
YOUTUBE_REFRESH_TOKEN=        # obtained once via scripts/get_refresh_token.py
PEXELS_API_KEY=                # Pexels API key, for stock b-roll
GOOGLE_TTS_CREDENTIALS_JSON=    # Cloud TTS service-account JSON, as a single line
TTS_PROVIDER=google
