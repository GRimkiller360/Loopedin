    {
      "seed_category": "science facts",
      "source_title": "\u0427\u0442\u043e \u0431\u0443\u0434\u0435\u0442, \u0435\u0441\u043b\u0438 \u043f\u0440\u044b\u0433\u043d\u0443\u0442\u044c \u043f\u0440\u044f\u043c\u043e \u0447\u0435\u0440\u0435\u0437 \u0417\u0435\u043c\u043b\u044e? \ud83d\ude31",
      "source_description": "\u0427\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u043e\u0439\u0434\u0451\u0442, \u0435\u0441\u043b\u0438 \u043f\u0440\u044b\u0433\u043d\u0443\u0442\u044c \u0432 \u0442\u0443\u043d\u043d\u0435\u043b\u044c \u0447\u0435\u0440\u0435\u0437 \u0432\u0441\u044e \u0417\u0435\u043c\u043b\u044e? \u0424\u0438\u0437\u0438\u043a\u0430 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442, \u043f\u043e\u0447\u0435\u043c\u0443 \u0432 \u0438\u0442\u043e\u0433\u0435 \u0442\u044b \u043e\u0441\u0442\u0430\u043d\u0435\u0448\u044c\u0441\u044f \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u0417\u0435\u043c\u043b\u0438. \ud83c\udf0d \u0412\u0438\u0434\u0435\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u043e \u0432 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438 \u043f\u043e\u0437\u043d\u0430\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0446\u0435\u043b\u044f\u0445. \u0415\u0441\u043b\u0438 \u0443 \u0442\u0435\u0431\u044f \u0435\u0441\u0442\u044c \u0440\u0443\u043a\u0438, \u043f\u043e\u0441\u0442\u0430\u0432\u044c \u043b\u0430\u0439\u043a \u0438 \u043f\u043e\u0434\u043f\u0438\u0448\u0438\u0441\u044c \u043d\u0430 \u043a\u0430\u043d\u0430\u043b!\n#\u0417\u0435\u043c\u043b\u044f #\u0424\u0438\u0437\u0438\u043a\u0430 #\u041d\u0430\u0443\u043a\u0430 #\u0424\u0430\u043a\u0442\u044b #Shorts",
